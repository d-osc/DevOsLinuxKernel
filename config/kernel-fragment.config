# kernel-fragment.config — DevOs customizations merged on top of arm64 defconfig
# Target: QEMU 'virt' machine + generic UEFI arm64 boards

# --- DevOs identity ---
CONFIG_LOCALVERSION="-devos"
CONFIG_DEFAULT_HOSTNAME="devos"

# --- initramfs support (root filesystem is the initrd) ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# --- pseudo filesystems ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# NOTE: serial-console options are arch-specific and appended by
# 10-build-kernel.sh (PL011 for aarch64, 8250 for x86_64).

# --- VirtIO devices (QEMU virt machine) ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- filesystems ---
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CP437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_9P_FS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y

# --- networking ---
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_PCI=y
